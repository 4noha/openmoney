# 三菱UFJ銀行
MUFG_ID=
MUFG_PW=

# VPASS (三井住友カード)
VPASS_ID=
VPASS_PW=

# Amazon
AMAZON_EMAIL=
AMAZON_PW=

# メルカリ
MERCARI_EMAIL=
MERCARI_PW=

# 三菱UFJカード（アメックス）
MUFG_AMEX_ID=
MUFG_AMEX_PW=
MUFG_AMEX_BIRTHDAY=  # 追加認証用・生年月日 YYYYMM（例: 199001）
# MUFG_AMEX_PHONE=   # 上記の代替: 電話番号下4桁

# オリコカード
ORICO_ID=
ORICO_PW=

# ヤフオク・Yahoo!ショッピング（共通）
YAHUOKU_ID=
YAHUOKU_PW=

# Makuake
MAKUAKE_EMAIL=
MAKUAKE_PW=

# CAMPFIRE
CAMPFIRE_EMAIL=
CAMPFIRE_PW=

# 楽天市場
RAKUTEN_ID=
RAKUTEN_PW=

# PayPal
PAYPAL_EMAIL=
PAYPAL_PW=

# AliExpress
ALIEXPRESS_EMAIL=
ALIEXPRESS_PW=

# レシート OCR（Claude Vision）
ANTHROPIC_API_KEY=

# Firebase / FCM (= Android アプリと OTP コード中継)
# 自分で Firebase project 作成 → service account JSON DL → 配置
# 詳細: docs/openmoney/README.md
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# FCM_STORAGE_BUCKET= (省略時 <FCM_PROJECT_ID>.firebasestorage.app)

# Gmail (= povo / wonder_studio / deepl / discord / googleplay plugin)
# Google アプリパスワードを発行: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AWS Cost Explorer (= scripts/aws_setup_billing_iam.py で IAM 自動生成)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# povo / vidIQ サブスク
POVO_PDF_PASSWORD=
POVO_LOCK_TOPPING_PERSONAL=
VIDIQ_EMAIL=
VIDIQ_PW=
